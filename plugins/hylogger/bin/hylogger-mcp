#!/usr/bin/env python3
# Purpose: launch the installed local plugin from a source checkout or its host cache copy.
import json
import os
import sys
from pathlib import Path


def main() -> None:
    config_root = Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config")))
    config_file = config_root / "hylogger/runtime.json"
    config = json.loads(config_file.read_text()) if config_file.is_file() else {}
    source = Path(__file__).resolve().parents[3]
    root_value = os.environ.get("HYLOGGER_HOME")
    if root_value is None:
        root_value = str(source) if (source / "pyproject.toml").is_file() else config.get("repo")
    if not root_value:
        raise ValueError("runtime not configured; run python3 scripts/setup_plugin.py in the checkout")
    root = Path(root_value).expanduser().resolve()
    python = root / "outputs/science-env/bin/python"
    if not python.is_file() or not os.access(python, os.X_OK):
        raise ValueError(f"science environment missing at {python}; follow the real-data quickstart")
    if not (root / "app/dist/index.html").is_file():
        raise ValueError("built book UI missing; run npm --prefix app run build in the checkout")
    data = os.environ.get("HYLOGGER_DATA_ROOT", config.get("data_root", str(root / "data/raw/nvcl")))
    cases = os.environ.get("HYLOGGER_CASES", config.get(
        "cases", str(Path.home() / ".local/share/hylogger/cases")))
    env = {**os.environ, "HYLOGGER_HOME": str(root), "PYTHONPATH": f"{root / 'src'}:{root}"}
    model_args = []
    if config.get("model") and os.environ.get("HYLOGGER_FIXTURE") != "1":
        model_args = ["--model", config["model"], "--model-python", config["model_python"]]
    argv = [str(python), "-m", "hylogger_bridge.mcp.server", "--tools", "expert",
            "--cases", str(cases), "--data-root", str(data), *model_args, *sys.argv[1:]]
    os.execve(python, argv, env)


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, TypeError, KeyError) as error:
        print(f"error: {error}", file=sys.stderr)
        sys.exit(1)
